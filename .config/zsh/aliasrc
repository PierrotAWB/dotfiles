# Verbosity and settings that you pretty much just always are going to want.
alias \
	cp="cp -iv" \
	mv="mv -iv" \
	rm="rm -vI" \
	mkdir="mkdir -pv"

# Colorize commands when possible.
alias \
    ls="gls -hN --color=auto --group-directories-first" \
    grep="rg --color=auto --no-ignore" \
    diff="diff --color=auto"


# Git commands
alias \
	ga="git add" \
	gaa="git add -A" \
	gb="git branch" \
    gbsc="git branch --show-current" \
    gbb="git branch --show-current" \
	gc="git commit" \
	gcf="git commit --fixup=HEAD" \
    gcfd="git clean -fd" \
    gcl="git clone" \
	gcp="git cherry-pick" \
	gcpa="git cherry-pick --abort" \
	gcpc="git cherry-pick --continue" \
	gco="git checkout" \
    gd="git diff" \
	gdc="gd --cached" \
	gd1="git diff HEAD^..HEAD" \
	gd2="git diff HEAD^^..HEAD" \
	gd3="git diff HEAD^^^..HEAD" \
	gd4="git diff HEAD^^^^..HEAD" \
	gf="git fetch" \
	gfo="git fetch origin" \
    gfomm="git fetch origin main:main" \
    glf="git log --pretty=format:'%C(auto)%h%x09%an%x09%ad%x09%s %C(auto)%d' --date=short" \
	glo="git log" \
	glog="git log --oneline --graph --decorate --all" \
	gm="git merge" \
    gma="git merge --abort" \
	gmt="git mergetool" \
	gpl="git pull" \
	gpu="git push" \
	gr="git fetch origin && git rebase --autostash @{u}" \
	grb="git rebase" \
    grb2="env GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash HEAD~2" \
	grba="git rebase --abort" \
	grbc="git rebase --continue" \
	grl="git reflog" \
	grev="git revert" \
    gsh="git show" \
	gst="git stash push" \
	gsl="git stash list" \
	gsa="git stash apply"

