# gs="git status" \
# This is needed to take precedence over ghostscript
gs() {
  git status "$@"
}

gcb() {
  git checkout -b "$1" "${2:-main}"
}

gl() {
  git log --color=always --decorate=short --pretty=format:'%C(auto)%h %s %d' "$@" | \
    sed -E 's/\[([A-Z]+-[A-Z0-9]+)\]/\1/; s/([A-Z]+-[A-Z0-9]+):? */[\1] /' | \
    less -RFX
}

